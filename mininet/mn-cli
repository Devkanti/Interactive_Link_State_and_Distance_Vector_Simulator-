#!/usr/bin/env python3
"""
mn-cli: Simple, Friendly Command-Line Interface for Mininet & Routing Simulator
==============================================================================
Easy commands for testing, pinging, breaking links, and inspecting routing tables.
"""

import sys
import json
import urllib.request
import urllib.error

ENDPOINT = "http://localhost:8080"

# ANSI Colors for terminal output
BOLD = "\033[1m"
GREEN = "\033[92m"
RED = "\033[91m"
YELLOW = "\033[93m"
CYAN = "\033[96m"
MAGENTA = "\033[95m"
RESET = "\033[0m"

def http_get(path):
    try:
        req = urllib.request.Request(f"{ENDPOINT}{path}", headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"{RED}[Error]{RESET} Failed connecting to bridge: {e}")
        return None

def http_post(path, data):
    try:
        body = json.dumps(data).encode("utf-8")
        req = urllib.request.Request(
            f"{ENDPOINT}{path}",
            data=body,
            headers={"Content-Type": "application/json", "Accept": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=4) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"{RED}[Error]{RESET} Failed sending command: {e}")
        return None

